{# Action URL без кавычек. Ключи ncdc.* — только для UI, в cfg не пишем. #}
#!version:1.0.0.1
##File header "#!version:1.0.0.1" can not be edited or deleted.##

#######################################################################################
##                        GLOBAL SETTINGS                                            ##
#######################################################################################
{% for key, value in config.global.items() %}
{% if value is not none and value != '' and not key.startswith('action_url.') and not key.startswith('ncdc.') %}
{{ key }} = {{ value | cfg }}
{% endif %}
{% endfor %}

#######################################################################################
##                        Phone Web UI (local users)                                 ##
#######################################################################################
{# static.security.* — надёжнее после factory reset; password_use_default=0 снимает
   экран «смените пароль» когда пароль уже задан провижинингом. #}
{% set admin_pw = config.global.get('ncdc.phone.admin_password') %}
{% set user_pw = config.global.get('ncdc.phone.user_password') %}
{% if admin_pw and admin_pw != 'admin' %}
static.security.user_name.admin = admin
static.security.user_password = {{ ('admin:' ~ admin_pw) | cfg }}
security.user_password = {{ ('admin:' ~ admin_pw) | cfg }}
{% endif %}
{% if user_pw and user_pw != 'user' %}
static.security.user_name.user = user
static.security.user_password = {{ ('user:' ~ user_pw) | cfg }}
security.user_password = {{ ('user:' ~ user_pw) | cfg }}
{% endif %}
{% if (admin_pw and admin_pw != 'admin') or (user_pw and user_pw != 'user') %}
security.password_use_default.enable = 0
{% endif %}

#######################################################################################
##                        Action URL Configuration                                   ##
#######################################################################################
action_url.enable = {{ 1 if config.global.get('action_url.enable') else 0 }}
{% if config.global.get('action_url.limit_ip') %}
action_url.limit_ip = {{ config.global.get('action_url.limit_ip') | cfg }}
{% endif %}
{% for key, value in config.global.items() %}
{% if key.startswith('action_url.') and key not in ['action_url.enable', 'action_url.limit_ip'] and value %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}
