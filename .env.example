# Copy to .env and fill in real values:
#   cp .env.example .env

DEBUG=false

# Public URL phones use (no trailing slash).
# Windows без Docker/Podman, uvicorn на 8000:
# PUBLIC_BASE_URL=http://ntdc-dev.bsmuk.ru:8000
PUBLIC_BASE_URL=https://ntdc.example.com

# Random string, at least 16 chars (python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=replace-with-a-long-random-string

# Admin UI (HTTP Basic)
NTDC_ADMIN_USER=admin
NTDC_ADMIN_PASS=replace-with-strong-admin-password

# Phone provisioning (Yealink static.auto_provision.username / password)
PROVISION_AUTH_ENABLED=true
PROVISION_USER=provision
PROVISION_PASS=replace-with-strong-provision-password
# После заводского сброса отдать только эти учётки, без SIP (иначе 401 на трубке)
PROVISION_BOOTSTRAP=true

# Пароль веб-UI трубки, не admin — иначе Yealink требует сменить заводской
PHONE_WEB_USER=admin
PHONE_WEB_PASSWORD=replace-with-phone-web-password

# Shared secret phones send as ?token= on Action URL
ACTION_URI_TOKEN=replace-with-random-token

# Create unknown MACs on first Action URL / cfg request
AUTO_ENROLL=true

# 1 = provisioned values overwrite local phone settings
BOOT_OVERWRITE_MODE=1

AUDIT_RETENTION_DAYS=90
OFFLINE_TIMEOUT_MINUTES=5

# Yealink web UI certificates are self-signed
AUTOP_VERIFY_SSL=false
AUTOP_TIMEOUT=5

DATABASE_URL=sqlite:///./data/ntdc.db
